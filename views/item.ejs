<%- include('partials/header') %>

<% 
  const cpuClass = metric.cpuUsagePercent > 80 ? 'metric-val danger' : 'metric-val';
  const ramClass = metric.ramUsagePercent > 80 ? 'metric-val danger' : 'metric-val';
  const diskClass = metric.diskUsagePercent > 80 ? 'metric-val danger' : 'metric-val';
%>

<div class="card-center">
  <div class="page-header">
    <h1 class="page-title" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;" title="<%= title %>">
      <%= title %>
    </h1>
    <a href="/" class="btn btn-secondary" style="flex-shrink: 0;">&larr; Назад к списку</a>
  </div>

  <div class="card">
    <div class="grid-2">
      <div class="info-box" style="min-width: 0;">
        <span class="metric-label">ID записи</span>
        <strong>#<%= metric.id %></strong>
      </div>
      <div class="info-box" style="min-width: 0;">
        <span class="metric-label">Сервер</span>
        <strong 
          style="color: var(--primary-color); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;" 
          title="<%= metric.serverId %>">
          <%= metric.serverId %>
        </strong>
      </div>
    </div>

    <hr style="border: 0; border-top: 1px solid var(--border-color); margin: 16px 0;">

    <div class="grid-3">
      <div class="metric-box">
        <span class="metric-label">CPU</span>
        <span class="<%= cpuClass %>"><%= metric.cpuUsagePercent || 0 %>%</span>
      </div>
      <div class="metric-box">
        <span class="metric-label">RAM</span>
        <span class="<%= ramClass %>"><%= metric.ramUsagePercent || 0 %>%</span>
      </div>
      <div class="metric-box">
        <span class="metric-label">Диск</span>
        <span class="<%= diskClass %>"><%= metric.diskUsagePercent || 0 %>%</span>
      </div>
    </div>

    <div class="traffic-row">
      <span style="color: var(--text-secondary); font-size: 14px;">Сетевой трафик:</span>
      <strong><%= metric.networkTrafficKbps || 0 %> Kbps</strong>
    </div>

    <div class="timestamp">
      Метка времени: <%= new Date(metric.timestamp).toLocaleString('ru-RU') %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>