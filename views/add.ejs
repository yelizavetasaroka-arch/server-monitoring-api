<%- include('partials/header') %>

<div class="card-form-medium">
  <h1><%= title %></h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert-error">
      <%= error %>
    </div>
  <% } %>

  <form action="/add" method="POST" class="card">
    <div class="form-group">
      <label>ID Сервера:</label>
      <input 
        type="text" 
        name="serverId" 
        id="serverId-input"
        required 
        maxlength="50" 
        placeholder="srv-node-03"
        oninvalid="this.setCustomValidity('Заполните это поле. Идентификатор сервера не может быть пустым')"
        oninput="this.setCustomValidity('')"
      >
    </div>
    <div class="form-group">
      <label>CPU (%):</label>
      <input type="number" step="0.1" min="0" max="100" name="cpuUsagePercent" class="percent-input" required placeholder="45.5">
    </div>
    <div class="form-group">
      <label>RAM (%):</label>
      <input type="number" step="0.1" min="0" max="100" name="ramUsagePercent" class="percent-input" required placeholder="60.0">
    </div>
    <div class="form-group">
      <label>Диск (%):</label>
      <input type="number" step="0.1" min="0" max="100" name="diskUsagePercent" class="percent-input" required placeholder="30.0">
    </div>
    <div class="form-group">
      <label>Трафик (Kbps):</label>
      <input 
        type="number" 
        min="0" 
        max="10000000" 
        step="0.1" 
        name="networkTrafficKbps" 
        id="traffic-input" 
        placeholder="1000"
      >
    </div>
    <button type="submit" class="btn btn-full">Сохранить метрику</button>
  </form>
</div>

<script>
  // Запрет ввода пробелов для ID сервера (и с клавиатуры, и при вставке)
  const serverIdInput = document.getElementById('serverId-input');
  if (serverIdInput) {
    serverIdInput.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.code === 'Space') {
        e.preventDefault();
      }
    });
    serverIdInput.addEventListener('input', function() {
      this.value = this.value.replace(/\s/g, '');
    });
  }

  document.querySelectorAll('input[type="number"]').forEach(input => {
    // Запрет ввода минусов и экспоненты
    input.addEventListener('keydown', (e) => {
      if (e.key === '-' || e.key === 'e' || e.key === 'E') e.preventDefault();
    });

    // Универсальная замена запятых на точки и ограничение: не более ОДНОГО знака после точки
    input.addEventListener('input', function() {
      if (this.value.includes(',')) {
        this.value = this.value.replace(/,/g, '.');
      }
      if (this.value.includes('.')) {
        let p = this.value.split('.');
        if (p[1].length > 1) this.value = p[0] + '.' + p[1].slice(0, 1);
      }
    });
  });

  const enforceMax = (input, maxVal) => {
    input.addEventListener('input', () => {
      if (parseFloat(input.value) > maxVal) input.value = maxVal;
    });
  };

  document.querySelectorAll('.percent-input').forEach(input => enforceMax(input, 100));
  const trafficInput = document.getElementById('traffic-input');
  if (trafficInput) enforceMax(trafficInput, 10000000);
</script>

<%- include('partials/footer') %>