<%- include('partials/header') %>

<div class="card-form-small">
  <form action="/login" method="POST" class="card">
    <h1 style="margin-top: 0; font-size: 20px; text-align: center;"><%= title %></h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-error" style="text-align: center;">
        <%= error %>
      </div>
    <% } %>

    <div class="form-group">
      <label>Email:</label>
      <input type="email" name="email" required maxlength="50" placeholder="admin@example.com">
    </div>

    <div class="form-group">
      <label>Пароль:</label>
      <input type="password" name="password" required maxlength="50" placeholder="••••••••">
    </div>

    <button type="submit" class="btn btn-full">Войти в систему</button>
  </form>
</div>

<%- include('partials/footer') %>