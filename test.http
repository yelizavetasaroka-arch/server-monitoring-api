@baseUrl = http://localhost:3000
@userToken = {{loginUser.response.body.token}}
@adminToken = {{loginAdmin.response.body.token}}

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user4@example.com",
  "password": "UserPass123!",
  "role": "user"
}

###

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "admin1@example.com",
  "password": "AdminPass123!",
  "role": "admin"
}


# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "UserPass123!"
}

###

# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "AdminPass123!"
}

###

GET {{baseUrl}}/auth/profile
Authorization: Bearer {{userToken}}

###

GET {{baseUrl}}/metrics

###


GET {{baseUrl}}/metrics
Authorization: Bearer {{userToken}}

###

GET {{baseUrl}}/metrics/1
Authorization: Bearer {{userToken}}

###

GET {{baseUrl}}/metrics/999
Authorization: Bearer {{userToken}}

###


POST {{baseUrl}}/metrics
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "serverId": "srv-db-01",
  "cpuUsagePercent": 91.5,
  "ramUsagePercent": 84.0,
  "diskUsagePercent": 60.2,
  "networkTrafficKbps": 3400
}

###

POST {{baseUrl}}/metrics
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "serverId": "srv-db-01",
  "cpuUsagePercent": 91.5,
  "ramUsagePercent": 84.0,
  "diskUsagePercent": 60.2,
  "networkTrafficKbps": 3400
}

###

POST {{baseUrl}}/metrics
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "serverId": "srv-db-01"
}

###
PUT {{baseUrl}}/metrics/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "serverId": "srv-node-01-updated",
  "cpuUsagePercent": 15.0,
  "ramUsagePercent": 40.0,
  "diskUsagePercent": 82.1,
  "networkTrafficKbps": 500
}

###

DELETE {{baseUrl}}/metrics/1
Authorization: Bearer {{userToken}}

###

DELETE {{baseUrl}}/metrics/1
Authorization: Bearer {{adminToken}}