@baseUrl = http://localhost:3000
@userToken = {{loginUser.response.body.token}}
@adminToken = {{loginAdmin.response.body.token}}

### 1. Регистрация обычного пользователя (user)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "UserPass123!",
  "role": "user"
}

###

### 2. Регистрация администратора (admin)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "AdminPass123!",
  "role": "admin"
}

###

### 3. Вход обычного пользователя (получение токена)
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "UserPass123!"
}

###

### 4. Вход администратора (получение токена)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "AdminPass123!"
}

###

### 5. Получение профиля текущего пользователя (GET /auth/profile)
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{userToken}}

###

### 6. GET /metrics - Попытка без токена (Ожидается 401 Unauthorized)
GET {{baseUrl}}/metrics

###

### 7. GET /metrics - Список метрик с токеном пользователя (Ожидается 200 OK)
GET {{baseUrl}}/metrics
Authorization: Bearer {{userToken}}

###

### 8. GET /metrics/1 - Получение метрики по ID
GET {{baseUrl}}/metrics/1
Authorization: Bearer {{userToken}}

###

### 9. GET /metrics/999 - Ошибка 404 (Метрика не найдена)
GET {{baseUrl}}/metrics/999
Authorization: Bearer {{userToken}}

###

### 10. POST /metrics - Попытка создания обычным пользователем (Ожидается 403 Forbidden)
POST {{baseUrl}}/metrics
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "serverId": "srv-db-01",
  "cpuUsagePercent": 91.5,
  "ramUsagePercent": 84.0,
  "diskUsagePercent": 60.2,
  "networkTrafficKbps": 3400
}

###

### 11. POST /metrics - Создание новой метрики Администратором (Ожидается 201 Created)
POST {{baseUrl}}/metrics
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "serverId": "srv-db-01",
  "cpuUsagePercent": 91.5,
  "ramUsagePercent": 84.0,
  "diskUsagePercent": 60.2,
  "networkTrafficKbps": 3400
}

###

### 12. POST /metrics - Ошибка 400 (Некорректные данные)
POST {{baseUrl}}/metrics
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "serverId": "srv-db-01"
}

###

### 13. PUT /metrics/1 - Обновление метрики Администратором
PUT {{baseUrl}}/metrics/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "serverId": "srv-node-01-updated",
  "cpuUsagePercent": 15.0,
  "ramUsagePercent": 40.0,
  "diskUsagePercent": 82.1,
  "networkTrafficKbps": 500
}

###

### 14. DELETE /metrics/1 - Попытка удаления обычным пользователем (Ожидается 403 Forbidden)
DELETE {{baseUrl}}/metrics/1
Authorization: Bearer {{userToken}}

###

### 15. DELETE /metrics/1 - Успешное удаление метрики Администратором (Ожидается 200 OK)
DELETE {{baseUrl}}/metrics/1
Authorization: Bearer {{adminToken}}